# AgentSpaces Connect :: celld repository.
#
# What must be COMMITTED and therefore is deliberately NOT listed here:
#   .github/          the CI workflows and Dependabot config

# Maven build output
target/
dependency-reduced-pom.xml
release.properties
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
.flattened-pom.xml
.mvn/wrapper/maven-wrapper.jar

# Compiled classes outside target (IDE builds)
*.class
hs_err_pid*
replay_pid*

# IDEs and editors
.vscode/
.idea/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/
.factorypath
.apt_generated/
.sts4-cache/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Logs and scratch
*.log
/tmp/

# Peer key material, client keystores and provider keys never belong in a repository.
# The README's example keystore path is ./keys. A manifest may carry a bearer token
# inline (credential.bearer); prefer bearer-env or bearer-file, and keep such a file out.
keys/
peer.key
peer.keys/
*.pem
*.p12
*.jks

# Local environment
.env
.env.local
